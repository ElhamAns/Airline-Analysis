{
  "datasets": [
    {
      "name": "618ab07a",
      "displayName": "Flight Type Counts Summary",
      "queryLines": [
        "SELECT \r\n",
        "    flight_type,\r\n",
        "    COUNT(*) AS total_flights\r\n",
        "FROM gold.fact_flights\r\n",
        "GROUP BY flight_type"
      ],
      "catalog": "workspace",
      "schema": "gold"
    },
    {
      "name": "b0ba2089",
      "displayName": "Top Fifteen Airlines Ranked by Flight Volume",
      "queryLines": [
        "SELECT \n",
        "    al.airline_name,\n",
        "    COUNT(*) AS total_flights\n",
        "FROM gold.fact_flights f\n",
        "JOIN gold.dim_airline al ON f.airline_id = al.airline_id\n",
        "WHERE al.airline_id != -1\n",
        "GROUP BY al.airline_name\n",
        "ORDER BY total_flights DESC\n",
        "LIMIT 15;"
      ]
    },
    {
      "name": "top_aircraft",
      "displayName": "Top 10 Aircraft Models",
      "queryLines": [
        "SELECT\n",
        "  ac.aircraft_model,\n",
        "  COUNT(*) AS total_flights\n",
        "FROM\n",
        "  gold.fact_flights f\n",
        "    JOIN gold.dim_aircraft ac\n",
        "      ON f.aircraft_id = ac.aircraft_id\n",
        "WHERE\n",
        "  f.aircraft_id != -1\n",
        "GROUP BY\n",
        "  ac.aircraft_model\n",
        "ORDER BY\n",
        "  total_flights DESC\n",
        "LIMIT 10"
      ]
    },
    {
      "name": "terminal_dist",
      "displayName": "Terminal Distribution",
      "queryLines": [
        "SELECT\n",
        "  t.terminal,\n",
        "  COUNT(*) AS total_flights\n",
        "FROM\n",
        "  gold.fact_flights f\n",
        "    JOIN gold.dim_terminal t\n",
        "      ON f.terminal_id = t.terminal_id\n",
        "WHERE\n",
        "  f.terminal_id != -1\n",
        "GROUP BY\n",
        "  t.terminal"
      ]
    },
    {
      "name": "top_origins",
      "displayName": "Top 10 Origin Airports",
      "queryLines": [
        "SELECT\n",
        "  org.airport_name AS origin_airport,\n",
        "  COUNT(*) AS total_flights\n",
        "FROM\n",
        "  gold.fact_flights f\n",
        "    JOIN gold.dim_airport org\n",
        "      ON f.origin_airport_id = org.airport_id\n",
        "WHERE\n",
        "  f.origin_airport_id != -1\n",
        "GROUP BY\n",
        "  org.airport_name\n",
        "ORDER BY\n",
        "  total_flights DESC\n",
        "LIMIT 10"
      ]
    },
    {
      "name": "flight_attributes",
      "displayName": "Flight Attributes Distribution",
      "queryLines": [
        "SELECT\n",
        "  s.status,\n",
        "  f.isCargo,\n",
        "  f.codeshareStatus,\n",
        "  COUNT(*) AS total_flights\n",
        "FROM\n",
        "  gold.fact_flights f\n",
        "    LEFT JOIN gold.dim_status s\n",
        "      ON f.status_id = s.status_id\n",
        "GROUP BY\n",
        "  s.status,\n",
        "  f.isCargo,\n",
        "  f.codeshareStatus"
      ]
    },
    {
      "name": "top_destinations",
      "displayName": "Top 10 Destination Airports",
      "queryLines": [
        "SELECT\n",
        "  dest.airport_name AS destination_airport,\n",
        "  COUNT(*) AS total_flights\n",
        "FROM\n",
        "  gold.fact_flights f\n",
        "    JOIN gold.dim_airport dest\n",
        "      ON f.destination_airport_id = dest.airport_id\n",
        "WHERE\n",
        "  f.destination_airport_id != -1\n",
        "GROUP BY\n",
        "  dest.airport_name\n",
        "ORDER BY\n",
        "  total_flights DESC\n",
        "LIMIT 10"
      ]
    },
    {
      "name": "overview_stats",
      "displayName": "Overview Statistics",
      "queryLines": [
        "SELECT\n",
        "  COUNT(DISTINCT\n",
        "    CASE\n",
        "      WHEN airline_id != -1 THEN airline_id\n",
        "    END\n",
        "  ) AS total_airlines,\n",
        "  COUNT(DISTINCT\n",
        "    CASE\n",
        "      WHEN destination_airport_id != -1 THEN destination_airport_id\n",
        "    END\n",
        "  ) AS total_destinations,\n",
        "  COUNT(DISTINCT\n",
        "    CASE\n",
        "      WHEN aircraft_id != -1 THEN aircraft_id\n",
        "    END\n",
        "  ) AS total_aircraft\n",
        "FROM\n",
        "  gold.fact_flights"
      ]
    },
    {
      "name": "time_analysis",
      "displayName": "Flight Time Analysis",
      "queryLines": [
        "SELECT\n",
        "  d.month,\n",
        "  d.day_of_week_num,\n",
        "  COUNT(*) AS total_flights\n",
        "FROM\n",
        "  gold.fact_flights f\n",
        "    JOIN gold.dim_date d\n",
        "      ON f.date_id = d.date_id\n",
        "GROUP BY\n",
        "  d.month,\n",
        "  d.day_of_week_num"
      ]
    }
  ],
